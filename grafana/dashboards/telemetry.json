{
  "uid": "telemetry",
  "title": "Telemetry",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Kestrel connection duration: p95 by service",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(kestrel_connection_duration_seconds_bucket{job=\"yeezy-telemetry\"}[1m])))",
          "legendFormat": "{{job}}",
          "range": true
        }
      ]
    }
  ]
}
